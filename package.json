{
  "name": "meter-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Ingests smart-meter reads and serves billing.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest --exclude dist/**",
    "lint": "eslint .",
    "verify": "npm run lint && npm run build && npm test -- --run",
    "demo:compare": "node scripts/compare-search.mjs",
    "start": "node dist/services/readings/server.js"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "fastify": "5.6.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "10.0.7",
    "eslint": "9.39.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "pyright": "1.1.407",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vite": "7.3.7",
    "vitest": "4.0.8"
  }
}
